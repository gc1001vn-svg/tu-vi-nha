{
  "name": "tu-vi-nha",
  "version": "0.0.0",
  "description": "App tu vi gia dinh: am lich, tu vi, bat tu, xem ngay, phong thuy... cai len iPhone dang PWA, du lieu chi nam trong may.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/ghi_phien_ban.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prelint": "node scripts/ghi_phien_ban.mjs",
    "lint": "eslint .",
    "pretypecheck": "node scripts/ghi_phien_ban.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ghi_phien_ban.mjs",
    "test": "vitest run",
    "check:base": "node scripts/check_base_path.mjs",
    "check:khoa": "node scripts/check_khoa.mjs",
    "check:san": "node scripts/check_san.mjs",
    "do": "bash scripts/do.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gc1001vn-svg/tu-vi-nha.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tuquet/lunar": "0.1.0",
    "lunar-typescript": "1.8.6"
  }
}
